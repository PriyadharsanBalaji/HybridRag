# ===== GEMINI API CONFIGURATION =====
# Get your FREE API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyDPoAushw_8VboBMjnBxEVJILV4I-oaRpI



# Gemini Model Selection (FREE TIER - 2026)
GEMINI_MODEL=gemini-2.5-flash

# ===== RATE LIMITING (FREE TIER LIMITS) =====
MAX_REQUESTS_PER_MINUTE=15
MAX_REQUESTS_PER_DAY=1500
MAX_TOKENS_PER_MINUTE=1000000

# ===== CHROMA DB CONFIGURATION =====
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ===== EMBEDDING CONFIGURATION (FREE) =====
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== DOCUMENT PROCESSING =====
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_VECTOR_RESULTS=10
TOP_K_GRAPH_RESULTS=5
SIMILARITY_THRESHOLD=0.15

# ===== KNOWLEDGE GRAPH SETTINGS =====
ENABLE_KNOWLEDGE_GRAPH=true
ENTITY_CONFIDENCE_THRESHOLD=0.75
MAX_GRAPH_DEPTH=2

# ===== LLM SETTINGS =====
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048
TOP_P=0.95
TOP_K=40

# ===== UI CONFIGURATION =====
PAGE_TITLE=Hybrid RAG System
PAGE_ICON=🤖
LAYOUT=wide
THEME=dark

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ===== CACHE SETTINGS =====
ENABLE_CACHE=true
CACHE_TTL=3600
